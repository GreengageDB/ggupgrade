--------------------------------------------------------------------------------
-- Check migratable objects
--------------------------------------------------------------------------------

SET search_path TO migratable_tsquery;
SET

-- check data
SELECT * FROM table_with_tsquery_datatype_columns ORDER BY d;
 a         | b         | c         | d 
-----------+-----------+-----------+---
 'b' & 'c' | 'b' & 'c' | 'b' & 'c' | 1 
 'e' & 'f' | 'e' & 'f' | 'e' & 'f' | 2 
 'x' & 'y' | 'x' & 'y' | 'x' & 'y' | 3 
(3 rows)
SELECT * FROM table_with_tsquery ORDER BY name;
 name    | altitude  
---------+-----------
 elbrus  | 'c' & 'd' 
 everest | 'a' & 'b' 
(2 rows)

-- check that every column is a tsquery again
SELECT c.relname AS table_name, a.attname AS column_name, pg_catalog.format_type(a.atttypid, a.atttypmod) AS column_type FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace JOIN pg_catalog.pg_attribute a ON a.attrelid = c.oid WHERE n.nspname = 'migratable_tsquery' AND c.relkind IN ('r', 'p') AND a.attnum > 0 AND NOT a.attisdropped AND a.atttypid = 'pg_catalog.tsquery'::pg_catalog.regtype ORDER BY 1, 2;
 table_name                                              | column_name | column_type 
---------------------------------------------------------+-------------+-------------
 table_with_tsquery                                      | altitude    | tsquery     
 table_with_tsquery_column_attnum_equal_to_segment_count | a           | tsquery     
 table_with_tsquery_column_attnum_equal_to_segment_count | q           | tsquery     
 table_with_tsquery_datatype_columns                     | a           | tsquery     
 table_with_tsquery_datatype_columns                     | b           | tsquery     
 table_with_tsquery_datatype_columns                     | c           | tsquery     
 table_with_tsquery_datatype_columns_1_prt_1             | a           | tsquery     
 table_with_tsquery_datatype_columns_1_prt_1             | b           | tsquery     
 table_with_tsquery_datatype_columns_1_prt_1             | c           | tsquery     
 table_with_tsquery_datatype_columns_1_prt_2             | a           | tsquery     
 table_with_tsquery_datatype_columns_1_prt_2             | b           | tsquery     
 table_with_tsquery_datatype_columns_1_prt_2             | c           | tsquery     
 table_with_tsquery_datatype_columns_1_prt_3             | a           | tsquery     
 table_with_tsquery_datatype_columns_1_prt_3             | b           | tsquery     
 table_with_tsquery_datatype_columns_1_prt_3             | c           | tsquery     
 tsquery_cluster_comment                                 | j           | tsquery     
 tsquery_composite                                       | j           | tsquery     
 tsquery_composite                                       | k           | tsquery     
 tsquery_gist                                            | j           | tsquery     
 tsquery_gist                                            | k           | tsquery     
 tsquery_inherits                                        | a           | tsquery     
 tsquery_inherits                                        | b           | tsquery     
 tsquery_inherits                                        | c           | tsquery     
 tsquery_inherits                                        | e           | tsquery     
 tsquery_inherits_parent                                 | a           | tsquery     
 tsquery_inherits_parent                                 | b           | tsquery     
 tsquery_inherits_parent                                 | c           | tsquery     
(27 rows)

-- check indexes on the tsquery columns
SELECT c.relname AS table_name, i.relname AS index_name FROM pg_catalog.pg_index x JOIN pg_catalog.pg_class c ON c.oid = x.indrelid JOIN pg_catalog.pg_class i ON i.oid = x.indexrelid JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'migratable_tsquery' ORDER BY 1, 2;
 table_name                                              | index_name                                                  
---------------------------------------------------------+-------------------------------------------------------------
 table_with_tsquery                                      | table_with_tsquery_tsquery_idx                              
 table_with_tsquery_column_attnum_equal_to_segment_count | table_with_tsquery_column_attnum_equal_to_segment_count_idx 
 tsquery_cluster_comment                                 | tsquery_cluster_comment_idx                                 
 tsquery_composite                                       | tsquery_composite_idx                                       
 tsquery_gist                                            | tsquery_gist_idx                                            
(5 rows)

-- check the comment on the clustered index survived
SELECT pg_catalog.obj_description('migratable_tsquery.tsquery_cluster_comment_idx'::regclass, 'pg_class');
 obj_description 
-----------------
 hello world     
(1 row)

-- check views
SELECT viewname FROM pg_catalog.pg_views WHERE schemaname = 'migratable_tsquery' ORDER BY 1;
 viewname                                                     
--------------------------------------------------------------
 table_with_tsquery_column_attnum_equal_to_segment_count_view 
 view_on_tsquery                                              
 view_on_tsquery_mult_tables                                  
 view_on_view_and_table                                       
 view_on_view_on_tsquery                                      
(5 rows)

-- check the objects are usable, including the views stacked on other views
INSERT INTO table_with_tsquery VALUES ('kazbek', 'e & f'::tsquery);
INSERT 0 1
SELECT * FROM view_on_tsquery ORDER BY name;
 name    | altitude  
---------+-----------
 elbrus  | 'c' & 'd' 
 everest | 'a' & 'b' 
 kazbek  | 'e' & 'f' 
(3 rows)
-- sort on the text of the tsquery, the sort order of the type itself follows
-- its internal representation.
SELECT * FROM view_on_view_and_table ORDER BY name, altitude::text;
 name    | altitude  
---------+-----------
 elbrus  | 'a' & 'b' 
 elbrus  | 'c' & 'd' 
 elbrus  | 'e' & 'f' 
 everest | 'a' & 'b' 
 everest | 'c' & 'd' 
 everest | 'e' & 'f' 
 kazbek  | 'a' & 'b' 
 kazbek  | 'c' & 'd' 
 kazbek  | 'e' & 'f' 
(9 rows)

RESET search_path;
RESET
