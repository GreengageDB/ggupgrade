-- start_ignore
-- end_ignore
! mkdir /tmp/tablespace1;

! mkdir /tmp/tablespace2;

! mkdir /tmp/tablespace3;

create tablespace test_tablespace1 location '/tmp/tablespace1';
CREATE TABLESPACE
create tablespace test_tablespace2 location '/tmp/tablespace2' with (content1 = '/tmp/tablespace3');
CREATE TABLESPACE

select -1 as gp_segment_id, spcname, pg_tablespace_location(oid) as location from pg_tablespace union all select gp_segment_id, spcname, pg_tablespace_location(oid) as location from gp_dist_random('pg_tablespace');
 gp_segment_id | spcname          | location         
---------------+------------------+------------------
 -1            | pg_default       |                  
 -1            | pg_global        |                  
 -1            | test_tablespace1 | /tmp/tablespace1 
 -1            | test_tablespace2 | /tmp/tablespace2 
 2             | pg_default       |                  
 2             | pg_global        |                  
 2             | test_tablespace1 | /tmp/tablespace1 
 2             | test_tablespace2 | /tmp/tablespace2 
 0             | pg_default       |                  
 0             | pg_global        |                  
 0             | test_tablespace1 | /tmp/tablespace1 
 0             | test_tablespace2 | /tmp/tablespace2 
 1             | pg_default       |                  
 1             | pg_global        |                  
 1             | test_tablespace1 | /tmp/tablespace1 
 1             | test_tablespace2 | /tmp/tablespace3 
(16 rows)

create table ts1_test (a int,  b int) tablespace test_tablespace1;
CREATE TABLE
insert into ts1_test select a, a from generate_series(1, 10000)a;
INSERT 0 10000

create table ts2_test (a int, b int) tablespace test_tablespace2;
CREATE TABLE
insert into ts2_test select a, a from generate_series(1, 10000)a;
INSERT 0 10000
